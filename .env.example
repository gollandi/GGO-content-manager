# ── GGOMed Operator Cockpit — environment (12-factor, spec §8) ──────────────
# Copy to .env.local and fill in. Names must match exactly.

# Notion (editorial state + legacy mirrors + Ambrogio read-only)
NOTION_API_KEY=

# Legacy Sanity-mirror DBs (doomed — retire in Phase 3; legacy pages read them)
NOTION_CONTENT_ASSETS_DB=
NOTION_PIF_TICK_COMPLIANCE_DB=
NOTION_EVIDENCE_SOURCES_DB=
NOTION_SCHEMA_VALIDATION_DB=

# Native / external-API DBs that stay
NOTION_KEYWORDS_DB=
NOTION_PATIENT_JOURNEYS_DB=
NOTION_STAKEHOLDER_FEEDBACK_DB=
NOTION_ANNUAL_REVIEW_LOG_DB=
NOTION_CONTENT_REQUESTS_DB=

# Editorial workflow state (ids from ernesto-agents-house/.env — same names)
NOTION_CONTENT_CALENDAR_DB=
NOTION_TOPIC_POOL_DB=
NOTION_MEDIA_ASSETS_DB=
NOTION_CONTENT_NEEDS_DB=
NOTION_NEWSLETTER_ITEMS_DB=
NOTION_PUBLISH_QUEUE_DB=
NOTION_ERNESTO_DESK_DB=
NOTION_AGENTS_ACTIVITY_LOG_DB=
NOTION_PERFORMANCE_SNAPSHOT_DB=

# Ambrogio — READ-ONLY in the Shell (independence by construction)
NOTION_AMBROGIO_AUDITS_DB=
NOTION_AMBROGIO_PROPOSALS_DB=

# Sanity — GGOMed site (content + PIF assessment). Read-only viewer token:
# private medicalInterventionEntity docs vanish silently without it.
NEXT_PUBLIC_SANITY_PROJECT_ID=gxyjgvr0
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-12-03
SANITY_VIEWER_TOKEN=

# Sanity — Patient-Compass PIF traceability slice ONLY (read-only)
SANITY_M05_PROJECT_ID=m05ykm6e
SANITY_M05_DATASET=production
SANITY_M05_VIEWER_TOKEN=
SANITY_M05_TENANT_SCOPE=ggomed

# View HTTP API base — loopback in Phase 1, remote control-plane in Phase 2
VIEW_API_BASE_URL=
# Machine-to-machine token for /api/views/* (ernesto's cron/skills).
# Unset = no bypass, session-only. Generate: openssl rand -hex 32
COCKPIT_SERVICE_TOKEN=

# La Casa di Ernesto — generative runner (Anthropic only; drafts-only writes)
ANTHROPIC_API_KEY=
# Editor-role token for gxyjgvr0 — the runner writes drafts.* ONLY (enforced
# in code); publish stays in the Studio, with JJ.
SANITY_GGOMED_WRITE_TOKEN=
# Optional overrides
COCKPIT_RUNNER_MODEL=claude-opus-4-8
COCKPIT_RUNNER_MAX_TURNS=40
COCKPIT_SKILLS_DIR=

# Il Carico — media inbox on the server (phone upload → worker).
# On the VPS: /srv/ggo-media (owned by the service user). Unset in dev, where
# it falls back to a repo-local .media/ so nobody writes to /srv by accident.
COCKPIT_MEDIA_ROOT=
# Per-file ceiling in bytes (default 2 GiB) and per-chunk ceiling (16 MiB).
COCKPIT_MEDIA_MAX_BYTES=
COCKPIT_MEDIA_MAX_CHUNK_BYTES=

# Auth — simplest path: email/password (no Google OAuth client needed).
# AUTH_SECRET:           openssl rand -base64 32
# COCKPIT_USER_HASH_B64: node -e "require('bcryptjs').hash('YOUR-PASSWORD', 10).then(h => console.log(Buffer.from(h).toString('base64')))"
# (base64, NOT the raw bcrypt hash — Next's dotenv-expand mangles raw `$` sequences)
AUTH_SECRET=
COCKPIT_USER_EMAIL=
COCKPIT_USER_NAME=
COCKPIT_USER_HASH_B64=
ADMIN_EMAIL=

# Auth — optional alternative: Google OAuth (leave empty if using the above)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Morning brief — the Notion page ernesto-agents-house rewrites at 07:00.
# Read-only in the Shell (La Casa di Ernesto shows it); optional.
NOTION_ERNESTO_BRIEF_PAGE_ID=
