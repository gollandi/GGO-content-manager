[Unit]
Description=Hand JJ-ordered, staged Content Calendar rows to Buffer
After=ggo-content-manager.service
Requires=ggo-content-manager.service

[Service]
Type=oneshot
User=jj
Group=jj
EnvironmentFile=/etc/ggo-buffer-sweep.env
ExecStart=/usr/bin/python3 /srv/ggo-content-manager/tools/vps/buffer-sweep.py
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
