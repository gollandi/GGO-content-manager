<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: replace __REPO__ with the repo's absolute path (the install
     one-liner in tools/mac/update-resident.sh does this with sed). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>uk.co.ggomed.content-manager.update</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/tools/mac/update-resident.sh</string>
    </array>
    <!-- Twice a day matches how often main actually moves. For an
         on-demand update between the two slots:
           launchctl kickstart gui/$UID/uk.co.ggomed.content-manager.update -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>20</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/ggo-cockpit-update.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ggo-cockpit-update.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
